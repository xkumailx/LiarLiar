# ─── Liar Liar frontend environment ──────────────────────────────────────────
# Copy to `.env.local` and fill in the values.
# Never put real passwords, API keys, or secrets in this file.

# Public site URL (used for metadata, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL=https://liarliarbraeside.com.au

# Headless WordPress REST base (no trailing slash).
# Leave empty to use local fallback content.
WORDPRESS_API_URL=

# How long (seconds) to cache CMS responses before revalidating.
WORDPRESS_REVALIDATE_SECONDS=300

# OpenTable restaurant ID.
NEXT_PUBLIC_OPENTABLE_RID=

# External purchase link for gift cards.
NEXT_PUBLIC_GIFT_CARD_URL=

# Form submission webhooks.
NEWSLETTER_WEBHOOK_URL=
CONFESSION_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=

# WordPress credentials.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
